# Credenciais SMTP/IMAP internas — preencha no servidor.
# NUNCA coloque senha neste arquivo. Copie para backend/.env (gitignored).

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
SMTP_ALLOW_SELF_SIGNED=1

IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_SSL=1
IMAP_ALLOW_SELF_SIGNED=1
IMAP_POLL_SECONDS=25
