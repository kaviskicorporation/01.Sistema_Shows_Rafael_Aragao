# Copie para deploy/.env no servidor (NÃO commitar).
# cp deploy/env.example deploy/.env

DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=aragao.kaviskicorporation.com.br,localhost,127.0.0.1,backend
FRONTEND_ORIGIN=https://aragao.kaviskicorporation.com.br
AUTH_COOKIE_SECURE=1

POSTGRES_DB=aragao
POSTGRES_USER=aragao
POSTGRES_PASSWORD=troque-por-senha-forte-do-postgres

# SMTP/IMAP internos (somente neste arquivo no servidor — nunca no frontend)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1
SMTP_ALLOW_SELF_SIGNED=1
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_SSL=1
IMAP_ALLOW_SELF_SIGNED=1
IMAP_POLL_SECONDS=25
